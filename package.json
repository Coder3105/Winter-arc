    "verify:v2.2:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-2-database.ts",
    "verify:v2.2:responsive": "node --env-file=.env.local scripts/verify-responsive-v2-2.mjs",
    "verify:v2.2:email-templates": "node --import tsx scripts/verify-v2-2-email-templates.ts",
    "verify:v2.3:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-3-database.ts",
    "verify:v2.3:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-3.ts",
    "migrate:v2.4": "node --conditions=react-server --env-file=.env.local --import tsx scripts/migrate-v2-4.ts",
    "verify:v2.4:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-4-database.ts",
    "verify:v2.4:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-4.ts",
    "verify:v2.5:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-5-database.ts",
    "verify:v2.5:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-5.ts",
    "verify:v2.6:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-6.ts",
    "verify:v2.7:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-7-database.ts",
    "verify:v2.7:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-7.ts",
    "verify:v2.7:email-template": "node --import tsx scripts/verify-v2-2-email-templates.ts",
    "verify:v2.8:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-release-database.ts",
    "verify:v2.8:responsive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-responsive-v2-8.ts",
    "verify:v2.8:secrets": "node scripts/verify-v2-release-security.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mongoose": "9.10.3",
    "next": "16.3.7",
    "nodemailer": "^10.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "^6.30.0",
    "server-only": "0.0.1",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
