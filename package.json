{
  "name": "winter-arc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 90-day discipline and body-transformation system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap:owner": "node --conditions=react-server --env-file=.env.local --import tsx scripts/bootstrap-owner.ts",
    "migrate:v2.1": "node --conditions=react-server --env-file=.env.local --import tsx scripts/migrate-v2-1.ts",
    "verify:v2.1:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-v2-1-database.ts",
